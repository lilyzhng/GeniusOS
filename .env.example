# Copy to .env and fill in
GEMINI_API_KEY=
OPENAI_API_KEY=

# Voice front-end: openai (default) | gemini-live
# VOICE_BACKEND=openai
# GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

BRAIN_BACKEND=gemini
# BRAIN_BACKEND=codex              # pure OpenAI stack (uses OPENAI_API_KEY)
# GEMINI_MODEL=gemini-3.5-flash   # or gemini-2.5-pro for stronger viz reasoning (slower)
# OPENAI_BRAIN_MODEL=gpt-4.1      # model for codex backend (default: gpt-4.1)
