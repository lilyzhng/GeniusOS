{
  "version": 2,
  "framework": null,
  "builds": [
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "dest": "/public/how-it-works.html" },
    { "src": "/how-it-works", "dest": "/public/how-it-works.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
